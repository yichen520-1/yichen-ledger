# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# 打包中间产物（build/ 里的图标要提交，只忽略产物）
build/*.zip
build/*.dmg
build/*.exe
build/*.AppImage
build/_icon64.png

# 原生工程（由 `npx cap add` 生成，可按需重新生成）
android/
ios/
*.hprof

# 本地缓存 / 临时目录
.npm-cache/
.tmp-ssh/
.shots/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.*
!.env.example
