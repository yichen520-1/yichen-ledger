# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# 打包中间产物（build/ 里的图标要提交，只忽略产物）
build/*.zip
build/*.dmg
build/*.exe
build/*.AppImage
build/_icon64.png

# 原生工程：android/ 提交进仓库（内部自带 .gitignore 处理构建产物），
# ios/ 需要 macOS 才能生成，本地没生成过就先忽略
ios/
*.hprof

# 本地缓存 / 临时目录
.npm-cache/
.tmp-ssh/
.shots/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.*
!.env.example
