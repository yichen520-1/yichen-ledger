# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-electron/
release/
out/
*.tsbuildinfo

# 打包中间产物（build/ 里的图标要提交，只忽略产物）
build/*.zip
build/*.dmg
build/*.exe
build/*.AppImage
build/_icon64.png

# 原生工程：android/ 和 ios/ 都提交进仓库（内部自带 .gitignore 处理构建产物）
*.hprof

# 本地缓存 / 临时目录
.npm-cache/
.tmp-ssh/
.shots/
.android-tools/
.dsh/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 手工测试安装包时落在仓库根目录的副本（正式产物在 release/，也被忽略）
/setup.exe
/rel2/

# Python 生成图标时产生的字节码缓存
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 环境变量
.env
.env.*
!.env.example
